# Copy to deploy/.env and fill in. NEVER commit the real .env.
# Alerting (optional)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
SLACK_WEBHOOK_URL=
DISCORD_WEBHOOK_URL=
GENERIC_WEBHOOK_URL=
WEBHOOK_SECRET=
SMTP_HOST=
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=

# Web API bearer token. REQUIRED for the dashboard service in docker-compose:
# it binds to 0.0.0.0 inside the container and the server refuses a non-local
# bind without a token. Generate one with:  python -c "import secrets;print(secrets.token_urlsafe(32))"
WEBMON_API_TOKEN=
